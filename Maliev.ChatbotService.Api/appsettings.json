{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "MainModelName": "gemini-2.5-flash",
    "IntentModelName": "gemini-2.5-flash-lite",
    "ApiKey": "",
    "FileApiInlineThresholdBytes": 5242880,
    "FlexRetryMaxAttempts": 3,
    "FlexRetryBaseDelayMs": 5000,
    "BatchSummaryMaxSessions": 20,
    "BatchSummaryMaxInlineBytes": 18874368,
    "Agent": {
      "IncludeThoughts": true,
      "ThinkingBudgetTokens": 1024
    },
    "Chat": {
      "ImageMediaResolution": "medium",
      "PdfMediaResolution": "medium",
      "VideoMediaResolution": "low"
    },
    "Extraction": {
      "MediaResolution": "medium"
    },
    "UtilityRequests": {
      "ServiceTier": "flex"
    },
    "SafetySettings": {
      "Enabled": true,
      "Threshold": "BLOCK_ONLY_HIGH",
      "Categories": [
        "HARM_CATEGORY_HARASSMENT",
        "HARM_CATEGORY_HATE_SPEECH",
        "HARM_CATEGORY_SEXUALLY_EXPLICIT",
        "HARM_CATEGORY_DANGEROUS_CONTENT"
      ]
    },
    "ContextCache": {
      "Enabled": true,
      "TtlSeconds": 3600,
      "MaxStorageCostMicroUsd": 50000
    },
    "FileApi": {
      "ProcessingPollAttempts": 12,
      "ProcessingPollDelayMs": 5000
    },
    "Webhooks": {
      "QueueCapacity": 100
    },
    "UrlContext": {
      "Enabled": false,
      "MaxUrlsPerRequest": 3
    }
  },
  "Llm": {
    "Provider": "gemini",
    "OpenAICompatible": {
      "ModelName": "",
      "ApiKey": ""
    }
  },
  "Features": {
    "WebSearchEnabled": false
  },
  "RateLimiting": {
    "MessagesPerHour": 100,
    "SlidingWindowSeconds": 3600
  },
  "SessionConfiguration": {
    "ExpirationHours": 24,
    "EnableAutoSummary": true
  },
"FileUploadLimits": {
    "MaxImageSizeMB": 10,
    "MaxPdfSizeMB": 20,
    "MaxVideoSizeMB": 50,
    "MaxAudioSizeMB": 10
  },
  "ExternalClients": {
    "Gemini": {
      "BaseAddress": "https://generativelanguage.googleapis.com/"
    },
    "OpenAICompatible": {
      "BaseAddress": "https://api.openai.com/"
    },
    "Line": {
      "BaseAddress": "https://api.line.me/"
    },
    "Facebook": {
      "BaseAddress": "https://graph.facebook.com/"
    }
  }
}
