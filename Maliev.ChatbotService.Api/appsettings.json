{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "MainModelName": "gemini-2.5-flash",
    "IntentModelName": "gemini-2.5-flash-lite",
    "ApiKey": "",
    "UtilityRequests": {
      "ServiceTier": ""
    },
    "ContextCache": {
      "Enabled": true,
      "TtlSeconds": 3600
    }
  },
  "Llm": {
    "Provider": "gemini",
    "OpenAICompatible": {
      "ModelName": "",
      "ApiKey": ""
    }
  },
  "Features": {
    "WebSearchEnabled": false
  },
  "RateLimiting": {
    "MessagesPerHour": 100,
    "SlidingWindowSeconds": 3600
  },
  "SessionConfiguration": {
    "ExpirationHours": 24,
    "EnableAutoSummary": true
  },
"FileUploadLimits": {
    "MaxImageSizeMB": 10,
    "MaxPdfSizeMB": 20,
    "MaxVideoSizeMB": 50,
    "MaxAudioSizeMB": 10
  },
  "ExternalClients": {
    "Gemini": {
      "BaseAddress": "https://generativelanguage.googleapis.com/"
    },
    "OpenAICompatible": {
      "BaseAddress": "https://api.openai.com/"
    },
    "Line": {
      "BaseAddress": "https://api.line.me/"
    },
    "Facebook": {
      "BaseAddress": "https://graph.facebook.com/"
    }
  }
}
