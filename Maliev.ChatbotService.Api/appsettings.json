{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ChatbotDbContext": ""
  },
  "Gemini": {
    "ModelName": "gemini-2.0-flash-exp",
    "ApiKey": ""
  },
  "GoogleCustomSearch": {
    "ApiKey": "",
    "SearchEngineId": ""
  },
  "Features": {
    "IAMIntegrationEnabled": true,
    "WebSearchEnabled": false
  },
  "RateLimiting": {
    "MessagesPerHour": 100,
    "SlidingWindowSeconds": 3600
  },
  "SessionConfiguration": {
    "ExpirationHours": 24,
    "EnableAutoSummary": true
  },
  "FileUploadLimits": {
    "MaxImageSizeMB": 10,
    "MaxPdfSizeMB": 20,
    "MaxVideoSizeMB": 50,
    "MaxAudioSizeMB": 10
  }
}
